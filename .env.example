# Public Firebase Web config (public identifiers, not server secrets).
# Obtain from Firebase Console > Project settings > Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Server-only Firebase service-account JSON, stored as an encrypted Vercel env var.
# Never put a real value in this file, Git, frontend code, or browser storage.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Exact production site origin if/when cross-origin access is needed.
# Same-origin frontend/API deployments should not need permissive CORS.
APP_ORIGIN=
