{
  "name": "ajaynxt-social-hub",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "AJAYNXT Social Hub — Cloudflare Workers, D1, Firebase Auth",
  "scripts": {
    "build": "node scripts/sync-public.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ajaynxt-social-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply ajaynxt-social-hub --remote",
    "test": "node --test",
    "check:syntax": "node scripts/check-syntax.mjs"
  },
  "dependencies": { "jose": "^6.1.0" },
  "devDependencies": { "wrangler": "^4.40.0" }
}
